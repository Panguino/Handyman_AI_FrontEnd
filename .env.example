# Application
NODE_ENV=development
# Base URL for auth callbacks
NEXTAUTH_SECRET=
VERCEL_URL=http://localhost:3000

# Database — Neon Postgres (Prisma)
# Single pooled connection string (example below). Put your full URL from Neon.
# Example pattern (do not commit real secrets):
# postgresql://neondb_owner:YOUR_PASSWORD@ep-your-neon-host-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require"

# OpenAI (GPT-5)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5

# Object Storage (S3-compatible: AWS S3, Cloudflare R2, Supabase Storage)
S3_REGION=us-east-1
# For AWS S3 leave endpoint blank; for R2/Supabase provide a custom endpoint
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=handyman-ai-dev
# Some S3-compatible providers require path-style access (true/false)
S3_FORCE_PATH_STYLE=true
# Optional public base URL for serving images directly from the bucket/CDN
NEXT_PUBLIC_S3_PUBLIC_BASE_URL=

# Scheduling — Google Calendar
# OAuth (NextAuth Google Provider) — use OAuth Web creds (not service account)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Backwards compat if needed (will be used if OAUTH vars are not set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Calendar ID to create events on (e.g., your@gmail.com or a specific calendar's ID)
GOOGLE_CALENDAR_ID=
# Service Account (if used for server-to-server calendar)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Payments (optional) — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App Limits/Configs
MAX_UPLOAD_MB=15

